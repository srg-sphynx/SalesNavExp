{
  "name": "linkedin-scraper",
  "productName": "LinkedIn Scraper",
  "version": "3.3.0",
  "description": "A modern Mac app for scraping LinkedIn Sales Navigator leads",
  "author": "LinkedIn Scraper",
  "main": "main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "build": "npm run build:frontend && electron-builder --mac",
    "build:dmg": "npm run build:frontend && electron-builder --mac dmg"
  },
  "build": {
    "appId": "com.linkedinscraper.app",
    "productName": "LinkedIn Scraper",
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "minimumSystemVersion": "12.0"
    },
    "electronLanguages": [
      "en"
    ],
    "files": [
      "main.js",
      "preload.js",
      "frontend/dist/**/*",
      "lib/**/*",
      "credentials.json"
    ],
    "directories": {
      "output": "dist"
    }
  },
  "dependencies": {
    "@googleapis/drive": "^26.0.0",
    "google-auth-library": "^11.1.0",
    "playwright-core": "^1.63.0"
  },
  "devDependencies": {
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3"
  }
}
